def cmd_list(argv) -> int:
    p = argparse.ArgumentParser(prog="tmuxa list")
    p.add_argument("--json", action="store_true")
    a = p.parse_args(argv)
    # Read Claude's own self-reported status once (same source as tmux-claude-session-manager),
    # keyed by session_id; fall back to a TUI scrape for any session it doesn't cover.
    agents_status = agents_status_by_session(query_claude_agents())
    rows = []
    for n in sorted(list_session_names()):
        meta = read_meta(n)
        if session_exists(n):
            st = agents_status.get(meta.get("session_id"))
            if st == _AGENT_BUSY:
                state = "working"
            elif st == _AGENT_WAIT:
                state = "waiting"
            elif st == _AGENT_IDLE:
                state = "idle"
            else:
                state = "working" if is_working(capture(n), n) else "idle"
        else:
            state = "dead"
        started = meta.get("started_at")
        elapsed = round(time.time() - started, 1) if started else None
        rows.append({"session": n, "state": state, "elapsed_s": elapsed,
                     "cwd": meta.get("cwd", "?"), "prompt": meta.get("prompt", "")})
    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        print("(no tmuxa sessions)")
        return 0
    for r in rows:
        el = f"{r['elapsed_s']}s" if r["elapsed_s"] is not None else "-"
        print(f"{r['state']:8} {r['session']:20} {el:>8}  {r['cwd']}")
    return 0


def cmd_kill(argv) -> int:
    p = argparse.ArgumentParser(prog="tmuxa kill")
    p.add_argument("name", nargs="?")
    p.add_argument("--all", action="store_true")
    a = p.parse_args(argv)
    if a.all:
        names = list_session_names()
        for n in names:
            kill_session(n)
        print(f"killed {len(names)} session(s)")
        return 0
    if not a.name:
        print("tmuxa kill: provide a session name or --all", file=sys.stderr)
        return 2
    if not session_exists(a.name):
        print(f"tmuxa kill: no such session: {a.name}", file=sys.stderr)
        return 2
    kill_session(a.name)
    print(f"killed {a.name}")
    return 0


def cmd_attach(argv) -> int:
    p = argparse.ArgumentParser(prog="tmuxa attach")
    p.add_argument("name")
    p.add_argument("--exec", action="store_true",
                   help="exec the attach command instead of printing it")
    a = p.parse_args(argv)
    if not session_exists(a.name):
        print(f"tmuxa attach: no such session: {a.name}", file=sys.stderr)
        return 2
    cmd = ["tmux", "-S", SOCKET, "attach", "-t", a.name]
    if a.exec:
        os.execvp("tmux", cmd)
    print(" ".join(shlex.quote(c) for c in cmd))
    return 0


def cmd_logs(argv) -> int:
    p = argparse.ArgumentParser(prog="tmuxa logs")
    p.add_argument("name")
    p.add_argument("-n", type=int, default=0, help="show only the last N lines")
    p.add_argument("--grep", help="show only lines matching this regex")
    p.add_argument("--full", action="store_true", help="ignore -n; show everything")
    a = p.parse_args(argv)
    if session_exists(a.name):
        lines = clean_capture(capture(a.name, history=True))
    else:
        tpath = SESSIONS_DIR / a.name / "transcript.txt"
        rpath = SESSIONS_DIR / a.name / "raw.log"
        if tpath.exists():
            lines = tpath.read_text().split("\n")
        elif rpath.exists():
            text = rpath.read_bytes().decode("utf-8", "replace")
            lines = [l for l in (apply_cr(strip_ansi(x)).rstrip()
                                 for x in text.split("\n")) if l.strip()]
        else:
            print(f"tmuxa logs: no logs for: {a.name}", file=sys.stderr)
            return 2
    if a.grep:
        rx = re.compile(a.grep)
        lines = [l for l in lines if rx.search(l)]
    if a.n and not a.full:
        lines = lines[-a.n:]
    print("\n".join(lines))
    return 0


def _gather_prompts(opts) -> list[str]:
    prompts = list(opts.prompt or [])
    if opts.prompts_file:
        for line in pathlib.Path(os.path.expanduser(opts.prompts_file)).read_text().splitlines():
            if line.strip():
                prompts.append(line.rstrip("\n"))
    return prompts


def _build_slots(max_parallel: int | None) -> list[None]:
    """N worker slots = the parallelism cap (default 3). Credentials come from the
    ambient environment now (tmuxa no longer manages an account pool)."""
    return [None] * max(1, max_parallel or 3)


def cmd_batch(argv) -> int:
    """Run many prompts in parallel; each spawns its own `tmuxa -p` using ambient creds."""
    p = argparse.ArgumentParser(prog="tmuxa batch",
                                description="Run many prompts in parallel (ambient credentials).")
    p.add_argument("-p", "--prompt", action="append", help="a prompt (repeatable)")
    p.add_argument("--prompts-file", help="file with one prompt per line ('-' = stdin)")
    p.add_argument("--cwd")
    p.add_argument("--timeout", type=float, default=DEFAULTS["timeout"])
    p.add_argument("--max-parallel", type=int, default=3,
                   help="cap total parallelism (default: 3)")
    p.add_argument("--json", action="store_true")
    a = p.parse_args(argv)
    if a.prompts_file == "-":
        a.prompts_file = None
        a.prompt = (a.prompt or []) + [l for l in sys.stdin.read().splitlines() if l.strip()]
    prompts = _gather_prompts(a)
    if not prompts:
        print("tmuxa batch: no prompts (use -p ... or --prompts-file FILE)", file=sys.stderr)
        return 2

    slots = _build_slots(a.max_parallel)
    results: list[dict | None] = [None] * len(prompts)
    tasks: queue.Queue = queue.Queue()
    for i, pr in enumerate(prompts):
        tasks.put((i, pr))
    lock = threading.Lock()
    done = [0]

    def worker():
        while True:
            try:
                i, pr = tasks.get_nowait()
            except queue.Empty:
                return
            cmd = [sys.executable, SELF, "-p", pr, "--json", "--quiet",
                   "--timeout", str(a.timeout)]
            if a.cwd:
                cmd += ["--cwd", a.cwd]
            r = subprocess.run(cmd, capture_output=True, text=True)
            rec = {"prompt": pr, "exit_code": r.returncode}
            try:
                d = json.loads(r.stdout)
                rec.update({k: d.get(k) for k in
                            ("completion", "result", "session", "elapsed_s",
                             "claude_session_id", "claude_transcript")})
            except ValueError:
                rec["result"] = (r.stdout or r.stderr).strip()[-600:]
                rec["completion"] = "error"
            results[i] = rec
            with lock:
                done[0] += 1
                print(f"[tmuxa batch] {done[0]}/{len(prompts)} done — "
                      f"#{i} ({rec.get('completion')})", file=sys.stderr)

    print(f"[tmuxa batch] {len(prompts)} prompts · {len(slots)} parallel slots", file=sys.stderr)
    workers = [threading.Thread(target=worker, daemon=True) for _ in slots]
    for t in workers:
        t.start()
    for t in workers:
        t.join()

    if a.json:
        print(json.dumps(results, ensure_ascii=False, indent=2))
    else:
        for i, rec in enumerate(results):
            rec = rec or {}
            print(f"\n==== #{i} [{rec.get('completion')}] {rec.get('prompt', '')[:70]}")
            print((rec.get("result") or "").strip()[:800])
    return 0


