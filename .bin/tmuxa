# ─────────────────────────────────────────────────────────────────────────────

def _cache_root() -> pathlib.Path:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(
        os.path.expanduser("~"), ".cache")
    return pathlib.Path(base) / "tmuxa"

CACHE_ROOT = _cache_root()
SOCKET = str(CACHE_ROOT / "tmux.sock")          # tmux -S <path> (NOT -L: name+broken tmpdir)
SESSIONS_DIR = CACHE_ROOT / "sessions"
SELF = os.path.realpath(__file__)               # re-invoked by `tmuxa batch`

DEFAULTS = dict(
    timeout=600.0,       # wall-clock for the working phase (s)
    ready_timeout=20.0,  # TUI startup budget (s)
    idle_secs=4.0,       # quiescence window for idle-completion (s)
    poll_ms=400,         # poll interval (ms) — each poll forks tmux clients per session;
                         # 400 keeps the shared-server fork rate sane under many parallel agents
    agents_poll_ms=1500, # throttle for the `claude agents --json` status poll (ms) — that
                         # command forks a claude process and returns ALL agents globally, so it
                         # runs far less often than the frame poll to keep the fork rate sane
)

RESULT_DELIM = "===== TMUXA RESULT ====="


def claude_project_dir(cwd: str) -> pathlib.Path:
    """The ~/.claude/projects/<enc> dir Claude Code stores a cwd's transcripts in.

    Encoding (verified against the live project dirs): every non-alphanumeric char
    in the absolute cwd becomes '-' — e.g.
        /home/zx/firefox       -> -home-zx-firefox
        /home/zx/.config/nvim  -> -home-zx--config-nvim   (the '.' and both '/' map to '-')."""
    enc = re.sub(r"[^A-Za-z0-9]", "-", os.path.abspath(os.path.expanduser(cwd)))
    return pathlib.Path(os.path.expanduser("~")) / ".claude" / "projects" / enc


def claude_transcript_path(cwd: str, session_id: str) -> pathlib.Path:
    """Deterministic path of Claude Code's native JSONL transcript for a session.

    tmuxa spawns `claude --session-id <uuid>`, so this filename is fixed up front:
    a parent process can read the real event stream (final answer + tool calls)
    straight from this file instead of screen-scraping the TUI."""
    return claude_project_dir(cwd) / f"{session_id}.jsonl"

# Pane geometry: WIDE so the claude TUI does not hard-wrap long lines (e.g. a JSON answer with
# a long string value) — wrapping mangles structured output that a caller parses. Height only
# needs to fit the live UI (transcript + input box + footer): committed lines scroll into
# tmux scrollback, which we read back with `-S` (history-limit 100000), so a tall pane is NOT
# needed for correctness — and a shorter pane means the claude TUI re-renders far fewer rows on
# every spinner tick (a big CPU saving with many parallel agents). Override via env if needed.
PANE_W = int(os.environ.get("TMUXA_PANE_W", "230"))
PANE_H = int(os.environ.get("TMUXA_PANE_H", "60"))

# ─────────────────────────────────────────────────────────────────────────────
# Text cleaning (pure, probe-independent)
# ────────────────────────────────────────────────────────────────────────────

# CSI / OSC / DCS-PM-APC-SOS / 2-char escapes. DOTALL so OSC/DCS span newlines.
_ANSI_RE = re.compile(
    r"\x1b\[[0-?]*[ -/]*[@-~]"          # CSI ... final byte
    r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"  # OSC ... BEL or ST
    r"|\x1b[P^_X][^\x1b]*\x1b\\"         # DCS/PM/APC/SOS ... ST
    r"|\x1b[@-Z\\-_]",                   # other 2-char escapes
    re.DOTALL,
)

def strip_ansi(text: str) -> str:
    """Remove ANSI escape sequences (SGR, cursor, OSC, bracketed-paste, etc.)."""
    return _ANSI_RE.sub("", text)


def apply_cr(line: str) -> str:
    """Resolve carriage returns within a single line (progress-bar overwrite).

    Models a cursor returning to column 0 on '\\r' and overwriting in place,
    so a redrawn progress bar collapses to its final visible state.
    """
    buf: list[str] = []
    col = 0
    for ch in line:
        if ch == "\r":
            col = 0
        elif ch == "\b":
            col = max(0, col - 1)
        else:
            if col < len(buf):
                buf[col] = ch
            else:
                buf.append(ch)
            col += 1
    return "".join(buf)


# Box-drawing block U+2500–U+257F (borders, corners, tees) plus heavy/rounded.
_BOX_ONLY_RE = re.compile(r"^[\s─-╿]+$")
_VERT_BORDER_RE = re.compile(r"[│┃║]")  # │ ┃ ║

def is_box_border_line(line: str) -> bool:
    """True if the line is purely box-drawing chars / whitespace (a border)."""
    s = line.strip()
    return bool(s) and bool(_BOX_ONLY_RE.match(line))


def strip_box_gutter(line: str) -> str:
    """Strip a leading/trailing vertical box border + padding (input-box gutter)."""
    line = re.sub(r"^\s*[│┃║]\s?", "", line)
    line = re.sub(r"\s?[│┃║]\s*$", "", line)
    return line


def clean_frame_text(text: str) -> list[str]:
    """ANSI/CR-clean a captured frame or log slice into display lines.

    Border-only lines are dropped; gutter borders are stripped from content.
    Trailing whitespace is trimmed. (Noise-line filtering for the *stream*
    happens later against SIGNATURES; this is the universal layer.)
    """
    text = strip_ansi(text)
    out: list[str] = []
    for raw in text.split("\n"):
        line = apply_cr(raw).rstrip()
        if is_box_border_line(line):
            continue
        out.append(strip_box_gutter(line).rstrip())
    return out


# ─────────────────────────────────────────────────────────────────────────────
# Append-log tail reader (byte offset + partial-sequence carry + rotation)
# ─────────────────────────────────────────────────────────────────────────────

def _utf8_need(first: int) -> int:
    if first < 0x80:
        return 1
    if 0xC0 <= first < 0xE0:
        return 2
    if 0xE0 <= first < 0xF0:
        return 3
    if 0xF0 <= first < 0xF8:
        return 4
    return 1  # invalid lead byte; don't carry


def _ansi_tail_incomplete(tail: bytes) -> bool:
    """True if `tail` (starting at an ESC) is an unterminated escape sequence."""
    if not tail or tail[0] != 0x1B:
        return False
    if len(tail) == 1:
        return True
    b1 = tail[1]
    if b1 == ord("["):                       # CSI: ends with 0x40-0x7E
        return not any(0x40 <= c <= 0x7E for c in tail[2:])
    if b1 in (ord("]"), ord("P"), ord("^"), ord("_"), ord("X")):  # OSC/DCS/..: ST or BEL
        return not (b"\x1b\\" in tail or b"\x07" in tail)
    return False  # 2-char escape already complete with b1


def split_partial_tail(data: bytes) -> tuple[bytes, bytes]:
    """Split off an incomplete trailing UTF-8 char or ANSI escape to carry over."""
    cut = len(data)
    # incomplete trailing multibyte UTF-8
    j = len(data) - 1
    cont = 0
    while j >= 0 and (data[j] & 0xC0) == 0x80 and cont < 3:
        j -= 1
        cont += 1
    if j >= 0 and data[j] >= 0x80:
        need = _utf8_need(data[j])
        if (len(data) - j) < need:
            cut = j
    # incomplete trailing ANSI escape (search within the kept region)
    esc = data.rfind(0x1B, 0, cut)
    if esc != -1 and _ansi_tail_incomplete(data[esc:cut]):
        cut = esc
    return data[:cut], data[cut:]


class LogTail:
    """Incremental reader over a pipe-pane append-log; never re-emits old bytes."""

    def __init__(self, path: str):
        self.path = path
        self.offset = 0
        self._carry = b""
        self._key: tuple[int, int] | None = None

    def read_new(self) -> str:
        try:
            st = os.stat(self.path)
        except FileNotFoundError:
            return ""
        key = (st.st_dev, st.st_ino)
        if self._key is None:
            self._key = key
        elif key != self._key or st.st_size < self.offset:
            # rotated or truncated → rebase to start
            self._key, self.offset, self._carry = key, 0, b""
        with open(self.path, "rb") as f:
            f.seek(self.offset)
            chunk = f.read()
        self.offset += len(chunk)
        data = self._carry + chunk
        data, self._carry = split_partial_tail(data)
        return data.decode("utf-8", "replace")


# ─────────────────────────────────────────────────────────────────────────────
# Native Claude Code transcript — the AUTHORITATIVE completion signal.
#
# tmuxa pins `claude --session-id <uuid>`, so the sub-agent's own event stream lands
# at a deterministic JSONL path (claude_transcript_path). A completed turn ends with
# an `assistant` record whose message.stop_reason is `end_turn` (or `stop_sequence`);
# an in-flight tool loop is `tool_use`; a truncated turn is `max_tokens`. Reading that
# is version-proof, unlike screen-scraping the TUI spinner (see SIGNATURES below), and
# doesn't false-complete on a multi-minute "Waiting for API" stall. This is the primary
# done-detector; the TUI FSM (CompletionDetector) is only the fallback when the
# transcript is unavailable. (Metadata records — mode/permission-mode/custom-title/
# agent-name/last-prompt/file-history-snapshot/summary/system — are ignored by only
# tracking assistant/user records.)
# ─────────────────────────────────────────────────────────────────────────────

_DONE_STOPS = {"end_turn", "stop_sequence"}   # a settled turn awaiting the next input


class TranscriptDetector:
    """Incremental JSONL tail → completion verdict. Reuses LogTail's byte-offset +
    partial-line carry so a half-written trailing record (live append) is held over."""

    def __init__(self, path: str):
        self.path = path
        self._off = 0
        self._carry = b""
        self._key: tuple[int, int] | None = None
        self._last_msg: dict | None = None   # last non-sidechain assistant/user record

    def _pump(self) -> bool:
        """Ingest new bytes; update self._last_msg. False iff the file is missing/unreadable."""
        try:
            st = os.stat(self.path)
        except OSError:
            return False
        key = (st.st_dev, st.st_ino)
        if self._key is None:
            self._key = key
        elif key != self._key or st.st_size < self._off:   # rotated/truncated → rebase
            self._key, self._off, self._carry, self._last_msg = key, 0, b"", None
        try:
            with open(self.path, "rb") as f:
                f.seek(self._off)
                chunk = f.read()
        except OSError:
            return False
        self._off += len(chunk)
        data = self._carry + chunk
        nl = data.rfind(b"\n")
        if nl == -1:                    # no complete line yet — carry it all
            self._carry = data
            return True
        complete, self._carry = data[:nl], data[nl + 1:]
        for raw in complete.split(b"\n"):
            raw = raw.strip()
            if not raw:
                continue
            try:
                o = json.loads(raw.decode("utf-8", "replace"))
            except ValueError:
                continue
            if o.get("isSidechain"):
                continue
            if o.get("type") in ("assistant", "user"):
                self._last_msg = o
        return True

    def verdict(self) -> str | None:
        """'done' | 'max_tokens' | 'question' | None (working) | 'nofile' (use fallback)."""
        if not self._pump():
            return "nofile"
        o = self._last_msg
        if o is None or o.get("type") != "assistant":
            return None   # nothing yet, or a trailing user/tool_result (tools just ran)
        m = o.get("message") or {}
        sr = m.get("stop_reason")
        if sr == "max_tokens":
            return "max_tokens"          # done, but truncated — caller warns
        if sr in _DONE_STOPS:
            return "done"
        if sr == "tool_use":             # a dangling AskUserQuestion = waiting on the user
            for c in m.get("content") or []:
                if isinstance(c, dict) and c.get("type") == "tool_use" \
                        and c.get("name") == "AskUserQuestion":
                    return "question"
        return None                      # tool_use in flight → still working


def _iter_jsonl_head(path: pathlib.Path, limit: int):
    """Yield the first `limit` parseable JSON records of a JSONL file (skips blanks/garbage)."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for i, line in enumerate(f):
                if i >= limit:
                    return
                line = line.strip()
                if not line:
                    continue
                try:
                    yield json.loads(line)
                except ValueError:
                    continue
    except OSError:
        return


def _jsonl_has_session(path: pathlib.Path, sid: str, limit: int = 20) -> bool:
    return any((o.get("sessionId") or o.get("session_id")) == sid
               for o in _iter_jsonl_head(path, limit))


def _jsonl_first_user_contains(path: pathlib.Path, needle: str, limit: int = 40) -> bool:
    """True if the first (non-sidechain) user message in this log contains `needle`."""
    for o in _iter_jsonl_head(path, limit):
        if o.get("type") == "user" and not o.get("isSidechain"):
            c = o.get("message", {}).get("content")
            text = c if isinstance(c, str) else json.dumps(c, ensure_ascii=False)
            return needle in text
    return False


def find_transcript_once(cwd: str, session_id: str | None, *, since: float = 0.0,
                         prompt_needle: str | None = None) -> tuple[str | None, str | None]:
    """ONE non-blocking locate pass → (path, how). IDENTITY-based, parallel-safe: NEVER
    selects by mtime alone — a shared cwd (the meta-loop fan-out into /home/zx/firefox holds
    many concurrent sessions) would cross-wire agents. Preference: (1) the deterministic
    <session_id>.jsonl → how='deterministic'; (2) a file whose records carry our session_id →
    'session-id'; (3) the unique file whose first user message contains prompt_needle →
    'needle'. (2)/(3) mean the deterministic-path assumption broke (filename scheme changed).
    Returns (None, None) if nothing matched yet."""
    proj = claude_project_dir(cwd)
    if session_id and (proj / f"{session_id}.jsonl").exists():
        return str(proj / f"{session_id}.jsonl"), "deterministic"
    if not proj.is_dir():
        return None, None
    cands = []
    for p in proj.glob("*.jsonl"):
        try:
            if p.stat().st_mtime >= since - 2.0:       # prune obviously-old siblings
                cands.append(p)
        except OSError:
            pass
    if session_id:
        for p in cands:
            if _jsonl_has_session(p, session_id):
                return str(p), "session-id"
    if prompt_needle:
        hits = [p for p in cands if _jsonl_first_user_contains(p, prompt_needle)]
        if len(hits) == 1:                             # unique → ours; ambiguous → wait
            return str(hits[0]), "needle"
    return None, None


def resolve_transcript_path(cwd: str, session_id: str | None, *, since: float = 0.0,
                            prompt_needle: str | None = None, timeout: float = 15.0,
                            poll: float = 0.3, vlog=None) -> str | None:
    """Blocking poll wrapper around find_transcript_once (kept for standalone/CLI use).
    Warns when it has to fall back off the deterministic <session_id>.jsonl path. Returns the
    path str, or None if nothing matched within `timeout`. NOTE: stream_and_detect does NOT
    use this — it locates lazily in its poll loop because the interactive TUI writes the
    transcript with large, variable latency, so blocking here would stall short runs."""
    deadline = time.time() + timeout
    while True:
        path, how = find_transcript_once(cwd, session_id, since=since,
                                         prompt_needle=prompt_needle)
        if path:
            if how != "deterministic":
                warn(f"deterministic transcript {session_id}.jsonl absent; "
                     f"identity-matched {os.path.basename(path)} (via {how})")
            return path
        if time.time() >= deadline:
            return None
        time.sleep(poll)


# ─────────────────────────────────────────────────────────────────────────────
# Claude Code self-reported agent status — `claude agents --json`.
#
# This is the SAME completion signal tmux-claude-session-manager reads: every interactive
# Claude Code session reports its OWN state (busy / idle / waiting) to a supervisor daemon,
# and `claude agents --json` publishes it keyed by sessionId. Since tmuxa pins
# `claude --session-id <uuid>`, we look up OUR agent's record directly and map its status:
#     busy    -> a turn is in flight         (working)
#     idle    -> the turn settled, our move  (done)
#     waiting -> blocked on user input       (question, e.g. AskUserQuestion)
# Like the transcript stop_reason signal this is version-proof (no TUI screen-scrape) and
# immune to the spinner's API-stall false-idle, but it is even more direct: it is Claude's
# own notion of whether it is running, not an inference from its output stream — exactly why
# the session-manager trusts it. `claude agents --json` forks a claude process and returns
# ALL agents globally, so we poll it on a throttle, not every frame poll (fork-rate hygiene
# under heavy fan-out).
# ─────────────────────────────────────────────────────────────────────────────

_AGENT_BUSY, _AGENT_IDLE, _AGENT_WAIT = "busy", "idle", "waiting"


def query_claude_agents() -> list | None:
    """`claude agents --json` → parsed list of agent records, or None if unavailable.

    Returns None on any failure — an old claude without the `agents` subcommand, the
    supervisor daemon being down, a non-zero exit, or malformed output — so every caller
    degrades gracefully to the transcript / TUI signal instead of crashing."""
    try:
        r = subprocess.run(["claude", "agents", "--json"],
                           capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
    except ValueError:
        return None
    return data if isinstance(data, list) else None


def agents_status_by_session(agents: list | None) -> dict:
    """Map sessionId -> status from a `claude agents --json` payload (as parsed above)."""
    out: dict[str, str] = {}
    for a in agents or []:
        if not isinstance(a, dict):
            continue
        sid = a.get("sessionId") or a.get("session_id")
        st = a.get("status")
        if sid and st:
            out[sid] = st
    return out


class AgentsStatusDetector:
    """Throttled `claude agents --json` → completion verdict for one pinned session_id.

    Mirrors tmux-claude-session-manager's status method. `idle`/`waiting` only count as
    terminal AFTER we have observed `busy` at least once, so neither the brief pre-turn window
    (the daemon still reporting the previous idle, before it flips us to busy) nor a momentary
    registration gap false-completes: until a turn is confirmed in flight we report 'nostatus'
    and let the transcript / TUI fallback decide — which also covers a turn that finishes faster
    than our first status poll (we'd never see busy, so we must not claim to know it is done)."""

    def __init__(self, session_id: str, *, min_interval: float, clock=time.time):
        self.session_id = session_id
        self.min_interval = min_interval
        self.clock = clock
        self._last_poll = 0.0
        self._saw_busy = False
        self._verdict: str | None = "nostatus"

    def verdict(self) -> str | None:
        """'done' | 'question' | None (working) | 'nostatus' (unavailable → use fallback).
        Throttled: between polls it returns the last computed verdict without forking."""
        now = self.clock()
        if now - self._last_poll < self.min_interval:
            return self._verdict
        self._last_poll = now
        agents = query_claude_agents()
        if agents is None:
            self._verdict = "nostatus"          # command / daemon unavailable
            return self._verdict
        status = agents_status_by_session(agents).get(self.session_id)
        if status == _AGENT_BUSY:
            self._saw_busy = True
            self._verdict = None
        elif status == _AGENT_IDLE:
            self._verdict = "done" if self._saw_busy else "nostatus"
        elif status == _AGENT_WAIT:
            self._verdict = "question" if self._saw_busy else "nostatus"
        else:
            # our session not (yet) listed, or an unrecognised status → defer to fallback
            self._verdict = "nostatus"
        return self._verdict


# ─────────────────────────────────────────────────────────────────────────────
# tmux primitives (all on the private -S socket; no shell interpolation of input)
# ─────────────────────────────────────────────────────────────────────────────

class TmuxError(RuntimeError):
    pass


def have_tmux() -> bool:
    import shutil
    return shutil.which("tmux") is not None


def tmux(*args: str, input: str | None = None, socket: str = SOCKET,
         check: bool = False) -> subprocess.CompletedProcess:
    r = subprocess.run(["tmux", "-S", socket, *args],
                       input=input, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise TmuxError(f"tmux {' '.join(args[:2])}: {r.stderr.strip()}")
    return r


def server_alive(socket: str = SOCKET) -> bool:
    return tmux("list-sessions", "-F", "#", socket=socket).returncode == 0


def session_exists(name: str, socket: str = SOCKET) -> bool:
    return tmux("has-session", "-t", name, socket=socket).returncode == 0


def new_agent_session(name: str, cwd: str, claude_cmd: str,
                      env: dict[str, str], socket: str = SOCKET) -> None:
    """Spawn a detached pane running claude (PID 1 of the pane via exec)."""
    args = ["-f", "/dev/null", "new-session", "-d", "-s", name,
            "-x", str(PANE_W), "-y", str(PANE_H), "-c", cwd]
    for k, v in env.items():
        args += ["-e", f"{k}={v}"]
    args.append(claude_cmd)               # tmux runs this via the shell (exec replaces it)
    tmux(*args, socket=socket, check=True)
    tmux("set-option", "-t", name, "remain-on-exit", "on", socket=socket)
    tmux("set-option", "-g", "history-limit", "100000", socket=socket)


def attach_pipe(name: str, logpath: str, socket: str = SOCKET) -> None:
    tmux("pipe-pane", "-t", f"{name}:0.0", "-O", f"cat >> {logpath}", socket=socket)


def capture(name: str, *, history: bool = False, escapes: bool = False,
            start: int | None = None, socket: str = SOCKET) -> str:
    a = ["capture-pane", "-p", "-t", f"{name}:0.0"]
    if escapes:
        a.insert(1, "-e")
    if history:
        a += ["-J", "-S", "-"]
    elif start is not None:
        a += ["-J", "-S", str(start)]
    return tmux(*a, socket=socket).stdout


def display(name: str, fmt: str, socket: str = SOCKET) -> str:
    return tmux("display-message", "-p", "-t", f"{name}:0.0", fmt,
                socket=socket).stdout.strip()


def pane_status(name: str, socket: str = SOCKET) -> tuple[bool, int | None, str]:
    """Return (dead, exit_code_or_None, current_command)."""
    s = display(name, "#{pane_dead}|#{pane_dead_status}|#{pane_current_command}",
                socket=socket)
    dead_s, status_s, cmd = (s.split("|", 2) + ["", "", ""])[:3]
    code = int(status_s) if status_s.strip().lstrip("-").isdigit() else None
    return dead_s == "1", code, cmd


# Printable fence: `display-message` octal-escapes a control byte (e.g. \x01 -> "\001"),
# so a non-printable sentinel does NOT survive — use ASCII that won't open a capture frame.
_STATUS_SENTINEL = "@@TMUXA_PS@@"


def capture_with_status(name: str, *, start: int | None = None,
                        socket: str = SOCKET) -> tuple[str, tuple[bool, int | None, str]]:
    """capture-pane + pane status in ONE tmux client fork → (frame, (dead, code, cmd)).

    A streaming poll needs both the live frame and pane_dead/exit-code; issuing them as two
    `tmux` invocations doubles the process-creation rate, the dominant tmuxa CPU cost under
    many parallel agents. Chaining `display-message ; capture-pane` in a single client returns
    both: the status line comes first, fenced by _STATUS_SENTINEL, and the frame is everything
    after the closing fence (we only ever read the first two fences, so a fence appearing
    inside the captured TUI text cannot confuse the split)."""
    fmt = (_STATUS_SENTINEL + "#{pane_dead}|#{pane_dead_status}|#{pane_current_command}"
           + _STATUS_SENTINEL)
    cap = ["capture-pane", "-p", "-t", f"{name}:0.0"]
    if start is not None:
        cap += ["-J", "-S", str(start)]
    out = tmux("display-message", "-p", "-t", f"{name}:0.0", fmt, ";", *cap,
               socket=socket).stdout
    dead, code, cmd, frame = False, None, "", out
    if out.startswith(_STATUS_SENTINEL):
        end = out.find(_STATUS_SENTINEL, len(_STATUS_SENTINEL))
        if end != -1:
            status = out[len(_STATUS_SENTINEL):end]
            frame = out[end + len(_STATUS_SENTINEL):]
            if frame.startswith("\n"):
                frame = frame[1:]
            dead_s, code_s, cmd = (status.split("|", 2) + ["", "", ""])[:3]
            code = int(code_s) if code_s.strip().lstrip("-").isdigit() else None
            dead = dead_s == "1"
    return frame, (dead, code, cmd)


def send_key(name: str, key: str, socket: str = SOCKET) -> None:
    tmux("send-keys", "-t", f"{name}:0.0", key, socket=socket)


def load_and_paste(name: str, data: str, socket: str = SOCKET) -> None:
    """Inject arbitrary text as inert bytes (no shell), bracketed so multi-line
    stays one input block.

    Uses a per-session NAMED buffer (-b): tmux paste buffers are global to the
    server, so without a unique name, concurrent sends to different sessions on
    the shared socket race and cross prompts. -d drops the buffer after paste.
    """
    buf = f"tmuxa_{name}"
    tmux("load-buffer", "-b", buf, "-", input=data, socket=socket, check=True)
    tmux("paste-buffer", "-p", "-d", "-b", buf, "-t", f"{name}:0.0",
         socket=socket, check=True)


def kill_session(name: str, socket: str = SOCKET) -> None:
    tmux("kill-session", "-t", name, socket=socket)


def list_session_names(socket: str = SOCKET) -> list[str]:
    r = tmux("list-sessions", "-F", "#{session_name}", socket=socket)
    return r.stdout.split() if r.returncode == 0 else []


