#!/usr/bin/env python3
"""tmuxa — spawn and drive a Claude Code sub-agent inside a tmux session.

Agent-like delegation: `tmuxa -p "<prompt>"` launches a fresh, visible,
attachable `claude --dangerously-skip-permissions` session in its own tmux
session, feeds it the prompt, streams the work to stdout, detects when the
sub-agent has finished, and returns the final answer — so a parent Claude Code
instance can consume it like the built-in Agent tool's result.

Single file, python3 stdlib only. See README.md for design notes.
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import queue
import re
import shlex
import signal
import subprocess
import sys
import threading
import time
import uuid

