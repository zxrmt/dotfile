class ReadyTimeout(Exception):
    pass


class ClaudeExited(Exception):
    def __init__(self, code):
        self.code = code
        super().__init__(str(code))


_STATE = {"name": None, "keep": False}


def _on_signal(signum, frame):
    name = _STATE.get("name")
    if name and not _STATE.get("keep"):
        try:
            kill_session(name)
        except Exception:
            pass
    sys.exit(130)


def make_vlog(verbose: bool):
    def vlog(msg: str):
        if verbose:
            print(f"[tmuxa] {msg}", file=sys.stderr, flush=True)
    return vlog


def warn(msg: str) -> None:
    """Always-on stderr warning (NOT gated on --verbose): emitted whenever tmuxa
    takes a degraded/fallback path (transcript not found, identity-matched instead
    of the deterministic path, TUI screen-scrape fallback, truncated output). Safe
    against callers: they drain tmuxa's stderr on a separate pipe (see runner.py),
    so this never corrupts the stdout RESULT_DELIM / --json parsing."""
    print(f"[tmuxa] warning: {msg}", file=sys.stderr, flush=True)


def ensure_dirs() -> None:
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)


def make_marker() -> str:
    return f"<<TMUXA_DONE_{uuid.uuid4().hex[:8]}>>"


def sentinel_instruction(marker: str) -> str:
    return ("\n\n( System note to the assistant running this task: when the task is "
            "fully complete and you have given your final answer, print this exact line "
            f"by itself as your very last output, then stop — {marker} )")


def read_prompt(opts) -> str:
    if opts.prompt_file:
        return pathlib.Path(os.path.expanduser(opts.prompt_file)).read_text()
    if opts.prompt == "-":
        return sys.stdin.read()
    return opts.prompt or ""


def build_claude_cmd(name: str, opts) -> str:
    parts = ["exec", "claude", "--dangerously-skip-permissions","-n", shlex.quote(name)]
    if getattr(opts, "session_id", None):
        # Pin Claude Code's session id so its native transcript path is deterministic
        # (cmd_run resolves/validates opts.session_id; see claude_transcript_path).
        parts += ["--session-id", shlex.quote(opts.session_id)]
    if opts.model:
        parts += ["--model", shlex.quote(opts.model)]
    # Reasoning effort + tool allow/deny lists, forwarded verbatim to the claude TUI.
    # `--tools`/`--disallowedTools` let a caller pin the sub-agent to a read-only
    # toolset (e.g. Bash,Read) even though the session runs --dangerously-skip-permissions.
    if getattr(opts, "effort", None):
        parts += ["--effort", shlex.quote(opts.effort)]
    if getattr(opts, "tools", None):
        parts += ["--tools", shlex.quote(opts.tools)]
    if getattr(opts, "disallowed_tools", None):
        parts += ["--disallowedTools", shlex.quote(opts.disallowed_tools)]
    if opts.append_system_prompt:
        parts += ["--append-system-prompt", shlex.quote(opts.append_system_prompt)]
    return " ".join(parts)


def wait_until_ready(name: str, ready_timeout: float, poll: float, vlog) -> None:
    deadline = time.time() + ready_timeout
    dismissed = 0
    hits = 0
    while time.time() < deadline:
        dead, code, _ = pane_status(name)
        if dead:
            raise ClaudeExited(code)
        frame = capture(name)
        is_startup_prompt = (SIG["trust"].search(frame) or SIG["theme"].search(frame)
                             or SIG["press_enter"].search(frame))
        if dismissed < 6 and is_startup_prompt and not input_box_present(frame, name):
            vlog("dismissing a startup prompt (Enter = accept default)")
            send_key(name, "Enter")
            dismissed += 1
            time.sleep(0.7)
            continue
        if input_box_present(frame, name) and not is_working(frame, name):
            hits += 1
            if hits >= 2:
                vlog("input box ready")
                return
        else:
            hits = 0
        time.sleep(poll)
    raise ReadyTimeout()


def send_prompt(name: str, full: str, marker: str | None, poll: float, vlog) -> None:
    load_and_paste(name, full)
    needle = marker or (full.strip().splitlines() or [""])[-1][:30]
    t = time.time()
    while time.time() - t < 8:
        if not needle or needle in capture(name):
            break
        time.sleep(0.1)
    time.sleep(0.15)  # let the paste settle before submitting
    send_key(name, "Enter")
    vlog("prompt submitted")
    t = time.time()
    while time.time() - t < 6:
        f = capture(name)
        if is_working(f, name) or any(SIG["assistant"].search(l) for l in split_frame(f, name)[0]):
            return
        time.sleep(0.15)
    vlog("no turn detected after submit; re-sending Enter")
    send_key(name, "Enter")


def _transcript_mtime(path) -> float:
    """mtime of the native JSONL transcript, or -1.0 if unknown/missing (→ no backoff).
    A cheap stat (no process fork) used to pace polling off real agent activity."""
    if not path:
        return -1.0
    try:
        return os.stat(path).st_mtime
    except OSError:
        return -1.0


def stream_and_detect(name: str, marker: str | None, opts, vlog):
    differ = FrameDiffer(name, marker)
    detector = CompletionDetector(name, marker, opts.idle_secs)
    poll = opts.poll_ms / 1000.0
    # Adaptive backoff: pace the poll off REAL transcript growth (a cheap mtime stat, no
    # fork), not the wall clock. While the native JSONL is not growing — the agent is deep in
    # a think or inside a long tool call (the footer still says "working", so completion stays
    # gated by is_working) — stretch the interval up to backoff_cap to cut the tmux fork rate;
    # any new transcript record snaps it straight back to the base interval. The cap stays
    # under idle_secs so idle/sentinel detection keeps its granularity.
    # Completion is PRIMARY from the native JSONL transcript (version-proof); the TUI FSM
    # (CompletionDetector) is the BRIDGE until that file appears and the FALLBACK if it never
    # does. The interactive TUI writes <sid>.jsonl with large/variable latency, so we locate
    # it LAZILY here rather than blocking up front: a cheap deterministic stat every poll, the
    # heavier identity glob-scan only ~1×/s while still missing.
    det_path = getattr(opts, "claude_transcript", None)
    rcwd = getattr(opts, "resolve_cwd", None)
    sid = getattr(opts, "session_id", None)
    needle = getattr(opts, "prompt_needle", None)
    since = getattr(opts, "spawn_ts", 0.0)
    # PRIMARY completion signal: Claude's own self-reported status (`claude agents --json`),
    # the same method tmux-claude-session-manager uses. Keyed by our pinned session_id; None
    # when disabled or no sid, in which case detection is unchanged (transcript then TUI).
    adet = (AgentsStatusDetector(sid, min_interval=opts.agents_poll_ms / 1000.0)
            if sid and getattr(opts, "agents_status", True) else None)
    tdet: TranscriptDetector | None = None
    transcript = det_path          # path used for mtime-paced backoff (updated once located)
    tui_warned = False
    last_scan = 0.0
    backoff_cap = max(poll, min(1.2, opts.idle_secs * 0.5))
    last_mtime, cur = -1.0, poll
    deadline = time.time() + opts.timeout
    completion, detail = "timeout", None
    while time.time() < deadline:
        # Bounded window, NOT full history: detection + live streaming only need the live
        # region (prompt echo → input box); re-serializing the entire 100k-line scrollback
        # every poll is O(transcript). The authoritative answer is the native transcript
        # (cmd_run); this scrape is only the live ticker + a fallback. capture_with_status
        # folds the pane (dead/exit) into the SAME fork, so a poll forks tmux once, not twice.
        frame, status = capture_with_status(name, start=-1500)
        resp, has_box = split_frame(frame, name)   # one split pass, shared below
        if not opts.quiet:
            for line in differ.commit_new(resp):
                sys.stdout.write(line + "\n")
            sys.stdout.flush()

        # Crash first — the transcript cannot report that the process died (pane is kept
        # alive by remain-on-exit precisely so we can read the exit code here).
        dead, code, _ = status
        if dead:
            completion, detail = "crash", code
            vlog("completion=crash")
            break

        now = time.time()

        # PRIMARY completion signal: Claude's own self-reported status (`claude agents --json`),
        # the same method tmux-claude-session-manager reads. When it returns a definitive answer
        # it is authoritative — we do NOT consult the transcript/TUI this poll; only 'nostatus'
        # (command unavailable, or a turn not yet/never confirmed busy) falls through to them.
        av = adet.verdict() if adet is not None else "nostatus"
        if av == "done":
            completion, detail = "done", None
            vlog("completion=done (claude agents status=idle)")
            break
        if av == "question" and opts.on_question != "wait":
            completion, detail = "question", None
            vlog("completion=question (claude agents status=waiting)")
            break

        if av == "nostatus":
            # Status unavailable → the existing transcript-primary, TUI-fallback detection.
            # Lazily locate the transcript: cheap deterministic stat every poll, identity glob
            # scan only ~1×/s while still missing (keeps the fork/IO rate sane under fan-out).
            if tdet is None and (det_path or rcwd):
                path, how = (None, None)
                if det_path and os.path.exists(det_path):
                    path, how = det_path, "deterministic"
                elif rcwd and now - last_scan >= 1.0:
                    last_scan = now
                    path, how = find_transcript_once(rcwd, sid, since=since, prompt_needle=needle)
                if path:
                    tdet = TranscriptDetector(path)
                    transcript = path
                    if how != "deterministic":
                        warn(f"deterministic transcript {sid}.jsonl not found; using "
                             f"identity-matched {os.path.basename(path)} (via {how})")
                    vlog(f"transcript located ({how}): {path}")

            if tdet is not None:
                tv = tdet.verdict()
                if tv == "nofile":
                    warn("native transcript disappeared mid-run; falling back to TUI "
                         "screen-scrape for completion detection")
                    tdet = None                        # rest of the run uses the TUI FSM
                elif tv == "done":
                    completion, detail = "done", None
                    vlog("completion=done (transcript end_turn)")
                    break
                elif tv == "max_tokens":
                    warn("sub-agent turn ended on max_tokens (output truncated)")
                    completion, detail = "done", None
                    vlog("completion=done (transcript max_tokens; truncated)")
                    break
                elif tv == "question" and opts.on_question != "wait":
                    completion, detail = "question", None
                    vlog("completion=question (transcript AskUserQuestion)")
                    break
                # tv None (or a suppressed question under --on-question wait) → still working.
                # While the transcript is authoritative we do NOT consult the TUI FSM — that is
                # exactly what makes us immune to the spinner-scrape's API-stall false-idle.
            else:
                # TUI FSM — version-fragile spinner/idle scrape, used only as the bridge before
                # the transcript appears / the fallback if it never does. Warn once when it is
                # what actually decides completion (the user asked to be told on any fallback).
                verdict, d = detector.verdict(frame, resp, has_box, status)
                if verdict == "question" and opts.on_question == "wait":
                    verdict = None
                if verdict:
                    if not tui_warned:
                        warn("completion decided by TUI screen-scrape fallback (native "
                             "transcript did not appear in time); less reliable than the "
                             "transcript stop_reason signal")
                        tui_warned = True
                    completion, detail = verdict, d
                    vlog(f"completion={verdict} (TUI fallback)")
                    break
        # else: av is None (busy) or a suppressed question under --on-question wait →
        # authoritatively still working; skip the fallbacks and just pace the next poll.

        mtime = _transcript_mtime(transcript)
        if mtime > last_mtime:
            last_mtime, cur = mtime, poll          # fresh activity → poll fast
        elif mtime >= 0:
            cur = min(backoff_cap, cur * 1.5)      # quiescent → ease off
        time.sleep(cur)

    full = capture(name, history=True)
    try:  # persist a clean transcript so `tmuxa logs` works after the session dies
        (SESSIONS_DIR / name / "transcript.txt").write_text("\n".join(clean_capture(full)))
    except OSError:
        pass
    resp, _ = split_frame(full, name)
    if not opts.quiet:
        # flush from the full-history split so any lines that scrolled past the live
        # window during streaming are still emitted (indices share the same origin —
        # the first ● after the prompt echo — so emitted stays aligned).
        for line in differ.flush(resp):
            sys.stdout.write(line + "\n")
        sys.stdout.flush()
    if opts.full_transcript:
        body = "\n".join(l for l in resp if not is_status_line(l))
        if marker:
            body = body.replace(marker, "")
        answer = collapse_blanks(body).strip()
    else:
        answer = answer_from_response(resp, marker)
    if not answer:  # no ● block: question widget, or timeout/crash before a reply
        answer = cleaned_after_prompt(full, name)
    return completion, detail, answer


def exit_code_for(completion: str) -> int:
    return {"sentinel": 0, "idle": 0, "done": 0, "question": 0,
            "timeout": 3, "crash": 5}.get(completion, 0)


def emit_result(name, completion, detail, answer, opts) -> None:
    meta = read_meta(name)
    elapsed = round(time.time() - meta.get("started_at", time.time()), 1)
    if opts.json:
        print(json.dumps({
            "result": answer,
            "completion": completion,
            "needs_input": completion == "question",
            "exit_code": exit_code_for(completion),
            "session": name,
            "account": meta.get("account"),
            "elapsed_s": elapsed,
            "transcript_path": str(SESSIONS_DIR / name / "raw.log"),
            "claude_session_id": meta.get("session_id"),
            "claude_transcript": meta.get("claude_transcript"),
            "claude_transcript_exists": bool(meta.get("claude_transcript"))
                                        and os.path.exists(meta["claude_transcript"]),
        }, ensure_ascii=False, indent=2))
        return
    if not opts.quiet:
        sys.stdout.write("\n")
    sys.stdout.write(RESULT_DELIM + "\n")
    note = {
        "timeout": "[timeout] sub-agent did not finish in time; partial output below:\n",
        "crash": f"[crashed] claude exited unexpectedly (code={detail}); partial output below:\n",
        "question": "[needs input] sub-agent stopped to ask:\n",
    }.get(completion, "")
    if note:
        sys.stdout.write(note)
    sys.stdout.write(answer + ("" if answer.endswith("\n") else "\n"))
    sys.stdout.flush()


def cmd_run(opts) -> int:
    if not have_tmux():
        print("tmuxa: tmux not found on PATH", file=sys.stderr)
        return 6
    ensure_dirs()
    vlog = make_vlog(opts.verbose)
    name = opts.name or unique_name()
    if session_exists(name):
        print(f"tmuxa: session '{name}' already exists (use --name)", file=sys.stderr)
        return 2
    prompt = read_prompt(opts)
    if not prompt.strip():
        print("tmuxa: empty prompt", file=sys.stderr)
        return 2
    # --system-prompt-file FILE → inline its contents as --append-system-prompt. The
    # interactive TUI has no --system-prompt-file flag, so the file is *appended* to
    # claude's default system prompt (an explicit --append-system-prompt still wins).
    if getattr(opts, "system_prompt_file", None) and not opts.append_system_prompt:
        try:
            opts.append_system_prompt = pathlib.Path(
                os.path.expanduser(opts.system_prompt_file)).read_text()
        except OSError as e:
            print(f"tmuxa: cannot read --system-prompt-file "
                  f"{opts.system_prompt_file}: {e}", file=sys.stderr)
            return 2
    marker = make_marker() if opts.completion in ("hybrid", "sentinel") else None
    full = prompt + (sentinel_instruction(marker) if marker else "")
    cwd = os.path.abspath(os.path.expanduser(opts.cwd)) if opts.cwd else os.getcwd()
    # Force a known Claude Code session id (generated if not supplied) so its native
    # JSONL transcript lands at a DETERMINISTIC path the caller can read directly —
    # see claude_transcript_path(). build_claude_cmd passes it as `claude --session-id`.
    sid = getattr(opts, "session_id", None)
    if sid:
        try:
            uuid.UUID(str(sid))
        except ValueError:
            print(f"tmuxa: --session-id must be a valid UUID: {sid!r}", file=sys.stderr)
            return 2
        sid = str(sid)
    else:
        sid = str(uuid.uuid4())
    opts.session_id = sid
    transcript = claude_transcript_path(cwd, sid)
    opts.claude_transcript = str(transcript)   # stream_and_detect paces polling off its mtime
    # Render/traffic knobs for the spawned claude TUI — its own frame redraw is the dominant
    # CPU cost vs a headless `claude -p`, so trim everything non-essential:
    #   DISABLE_ALTERNATE_SCREEN      classic main-screen renderer (no fullscreen repaint)
    #   DISABLE_MOUSE                 no mouse-tracking churn
    #   DISABLE_NONESSENTIAL_TRAFFIC  no autoupdater/telemetry/error-report/feedback traffic
    #   DISABLE_TERMINAL_TITLE        no per-turn title escapes (also skips the Haiku title call)
    env = {"CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1",
           "CLAUDE_CODE_DISABLE_MOUSE": "1",
           "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
           "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"}
    # forward the caller's Anthropic/Claude API config to the sub-agent, so a custom
    # endpoint/token/model reaches it regardless of the shared tmux server's own env. This
    # is the sole credential channel: the caller (e.g. pijs runner.py) feeds the token via
    # ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL; with none set, claude uses its ~/.claude login.
    for k, v in os.environ.items():
        if (k.startswith("ANTHROPIC_") or k.startswith("CLAUDE_")) and k not in env:
            env[k] = v
    claude_cmd = build_claude_cmd(name, opts)

    _STATE["name"], _STATE["keep"] = name, opts.keep
    session_dir(name)
    write_meta(name, {"name": name, "cwd": cwd, "started_at": time.time(),
                      "prompt": prompt[:200], "completion": opts.completion,
                      "account": None,
                      "session_id": sid, "claude_transcript": str(transcript),
                      "socket": SOCKET, "pid": os.getpid()})
    log = str(SESSIONS_DIR / name / "raw.log")

    spawn_ts = time.time()   # lower bound for the transcript's mtime (created after spawn)
    try:
        new_agent_session(name, cwd, claude_cmd, env)
    except TmuxError as e:
        print(f"tmuxa: failed to spawn session: {e}", file=sys.stderr)
        return 6

    try:
        attach_pipe(name, log)
        vlog(f"spawned '{name}' (cwd={cwd}, session_id={sid})")
        vlog(f"native transcript -> {transcript}")
        wait_until_ready(name, opts.ready_timeout, opts.poll_ms / 1000.0, vlog)
        send_prompt(name, full, marker, opts.poll_ms / 1000.0, vlog)
        # Stash what stream_and_detect needs to LAZILY locate the native transcript in its
        # poll loop. The interactive TUI writes <sid>.jsonl with large, variable latency
        # (seconds to >10s on claude 2.1.205), so we do NOT block on it here: the loop keeps
        # the TUI FSM as a bridge and switches to the transcript the moment it appears (early
        # relative to a long audit's runtime — where the version-fragile scrape is riskiest).
        opts.claude_transcript = str(transcript)   # deterministic path (verified in-loop)
        opts.resolve_cwd = cwd
        opts.spawn_ts = spawn_ts
        opts.prompt_needle = prompt.strip()[:80] or None
        completion, detail, answer = stream_and_detect(name, marker, opts, vlog)
        emit_result(name, completion, detail, answer, opts)
        return exit_code_for(completion)
    except ReadyTimeout:
        print("tmuxa: claude TUI did not become ready in time", file=sys.stderr)
        sys.stderr.write(capture(name) + "\n")
        return 4
    except ClaudeExited as e:
        print(f"tmuxa: claude exited during startup (code={e.code})", file=sys.stderr)
        sys.stderr.write(capture(name, history=True) + "\n")
        return 5
    finally:
        if opts.keep:
            print(f"[tmuxa] session kept: tmux -S {SOCKET} attach -t {name}", file=sys.stderr)
        else:
            kill_session(name)
            _STATE["name"] = None


