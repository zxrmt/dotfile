def unique_name(prefix: str = "agent") -> str:
    return f"{prefix}-{uuid.uuid4().hex[:8]}"


def session_dir(name: str) -> pathlib.Path:
    d = SESSIONS_DIR / name
    d.mkdir(parents=True, exist_ok=True)
    return d


def write_meta(name: str, meta: dict) -> None:
    (session_dir(name) / "meta.json").write_text(json.dumps(meta, indent=2))


def read_meta(name: str) -> dict:
    try:
        return json.loads((SESSIONS_DIR / name / "meta.json").read_text())
    except (FileNotFoundError, ValueError):
        return {}


# ────────────────────────────────────────────────────────────────────────────
# Credentials — tmuxa no longer manages an account pool. The caller supplies the
# API token/endpoint/model via the environment (ANTHROPIC_AUTH_TOKEN /
# ANTHROPIC_BASE_URL / ANTHROPIC_*_MODEL) and/or `--model`; cmd_run forwards every
# ANTHROPIC_*/CLAUDE_* env var to the spawned claude pane. In pijs, runner.py reads
# config.py and FEEDS the chosen credential to the tmuxa command this way. With no
# token in the environment, claude in the pane uses its own ~/.claude login.
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# SIGNATURES — version-fragile regexes, pinned from probe frames (claude 2.1.179).
# Update these (and tests/fixtures) if the Claude Code TUI layout changes.
# Validated layout:
#   ❯ <text>     user prompt echoed into the transcript
#   ● <text>     assistant message / tool-use bullet
#   · Warping…   transient working spinner (glyph animates: · ✶ ✳ ✻ …)
#   ✻ Baked for 5s   transient "last turn took" timer
#   ───…── <name> ──   input-box top rule (carries the -n display name)
#   ✢ Warping…   working spinner, rendered JUST ABOVE the box rule ⇒ a turn is RUNNING
# NOTE: the footer hint is NOT a reliable running/idle signal anymore. Claude Code
# 2.1.198 dropped "esc to interrupt" and shows "… · ← for agents" even WHILE working,
# and a custom `statusLine` can rewrite the footer entirely. The version-proof signal
# is the built-in spinner (animation glyph + gerund…) above the box — see is_working().
# ─────────────────────────────────────────────────────────────────────────────

SIG = {
    "trust": re.compile(r"trust this folder|project you created or one you trust", re.I),
    "theme": re.compile(r"Choose the text style|Select your theme|to use dark mode", re.I),
    "press_enter": re.compile(r"Press Enter to continue|❯\s*1\.\s", re.I),
    "working": re.compile(r"esc to interrupt"),
    "assistant": re.compile(r"^●\s"),     # ●
    "prompt_echo": re.compile(r"^❯\s"),   # ❯
    # interactive AskUserQuestion multiple-choice widget (replaces the input box)
    "question_widget": re.compile(r"Enter to select|↑/↓ to navigate"),
}

_STATUS_GLYPHS = set("·∙⋅•◦‣⁂✢✣✤✥✦✧✩✪✫✬✭✮✯✰✱✲✳✴✵✶✷✸✹✺✻✼✽✾✿❀⭐")
_STATUS_GLYPHS |= {chr(c) for c in range(0x2800, 0x2900)}  # braille spinner cells
_BARE_GERUND = re.compile(r"^[A-Za-z][\w'’-]*…$")      # Warping…
_TIMER_TAIL = re.compile(r"\bfor \d+s$")


def is_status_line(line: str) -> bool:
    """Transient spinner / timer line (noise). Never matches ● or ❯ lines."""
    s = line.strip()
    if not s:
        return False
    if SIG["assistant"].match(s) or SIG["prompt_echo"].match(s):
        return False
    if s[0] in _STATUS_GLYPHS:
        return True
    if _BARE_GERUND.match(s):
        return True
    if _TIMER_TAIL.search(s) and len(s.split()) <= 4:
        return True
    return False


def _rule_re(name: str) -> re.Pattern:
    # input-box top rule carries the display name: "──── <name> ──"
    return re.compile(r"\b" + re.escape(name) + r"\s+─")


def _input_region(frame: str, name: str) -> str:
    """The live UI region: the named input-box rule and the few lines below it
    (input + bottom rule + footer). Scoping here avoids matching a stale footer
    that may have scrolled up into the transcript history."""
    lines = frame.split("\n")
    rule = _rule_re(name)
    for i in range(len(lines) - 1, -1, -1):
        if rule.search(lines[i]):
            return "\n".join(lines[i:i + 6])
    return ""


# Claude's built-in "working" spinner sits JUST ABOVE the input-box rule while a turn
# runs, and vanishes the instant the turn ends — so it, NOT the drifting footer hint,
# is the version-proof "is a turn running" signal. Observed forms (Claude Code 2.1.198):
#   ✢ Warping…                                             (bare gerund)
#   ✽ Manifesting… (1m 58s · almost done thinking …)       (gerund + live timer)
#   ✻ Moseying… (90s · ↓ 38.0k tokens)                     (gerund + live timer)
#   ✻ Waiting for API response · will retry in 2m 40s …    (API stall — NO gerund/timer!)
# The last form is a transient API overload/network stall: the agent is STILL mid-turn
# and will resume, so it must read as "working" or tmuxa completes on it after idle_secs
# (this is the failure that killed the round-2 planner during a 2m40s retry).
_GERUND       = re.compile(r"[A-Za-z][\w'’-]*…")          # "Warping…", "Manifesting…"
_LIVE_ELAPSED = re.compile(r"\((?:\d+\s*m\s*)?\d+\s*s\b")  # live timer "(12s" / "(1m 7s"
# Transient not-done spinner states whose text is NOT a gerund. These strings appear in
# the spinner line ONLY while a turn is in flight (never in a settled, idle frame), so
# matching them cannot false-positive on a completed answer.
_BUSY_TEXT = re.compile(
    r"esc to interrupt|Waiting for API|will retry|retrying|reconnect|resuming|"
    r"check your network|API Error|overloaded|rate.?limit|offline|stream", re.I)
_BOX_RULE = re.compile(r"─{20,}")    # a full-width input-box horizontal rule


def _box_top_index(lines: list[str], name: str):
    """Index of the input-box TOP rule. Prefer the NAMED rule (precise); else fall back
    to the box's SHAPE — the last pair of full-width ─ rules at the bottom of the frame.
    The name is not always rendered into the rule (version/width dependent), and when it
    is missing the spinner zone must still be found — otherwise is_working goes blind and
    a long think or API stall looks 100% idle. Returns None if no box is visible."""
    rule = _rule_re(name)
    for i in range(len(lines) - 1, -1, -1):
        if rule.search(lines[i]):
            return i
    rule_idxs = [i for i, l in enumerate(lines) if _BOX_RULE.search(l)]
    if not rule_idxs:
        return None
    # the input box is the last two rules (TOP, BOTTOM); its TOP is the second-to-last
    return rule_idxs[-2] if len(rule_idxs) >= 2 else rule_idxs[-1]


def _spinner_zone(frame: str, name: str) -> list[str]:
    """The few lines just ABOVE the input-box TOP rule, where the working spinner
    renders. Deliberately excludes the box, statusline and footer BELOW it: those carry
    a user-customizable `statusLine` we must not treat as agent activity. Empty when no
    input box is visible — never scan the statusline."""
    lines = frame.split("\n")
    idx = _box_top_index(lines, name)
    if idx is None:
        return []
    return lines[max(0, idx - 4):idx]


def _is_spinner_line(line: str) -> bool:
    """A working-spinner line: an optional animation glyph, then a gerund ending in '…'
    ("✢ Warping…"). Excludes the post-turn 'Baked for 5s' timer (no '…')."""
    s = line.strip()
    if not s:
        return False
    if s[0] in _STATUS_GLYPHS:          # strip the leading animation glyph, if any
        s = s[1:].lstrip()
    return bool(_GERUND.match(s))        # first token must be a gerund ("Warping…")


def is_working(frame: str, name: str) -> bool:
    """True iff a turn is running. Robust to Claude Code footer/statusLine drift: in the
    zone above the input box, detect the spinner (glyph + gerund…), a live elapsed timer,
    or a transient API-stall/retry line; then fall back to the legacy 'esc to interrupt'
    hint for older TUIs. See also the motion backstop in CompletionDetector.verdict()."""
    for line in _spinner_zone(frame, name):
        if _is_spinner_line(line):
            return True
        # A live-timer / API-stall spinner carries no gerund, but Claude ALWAYS renders it
        # with a leading animation glyph ("✻ Waiting for API response · will retry …",
        # "✽ Manifesting… (1m 2s …)"), so gate _LIVE_ELAPSED/_BUSY_TEXT on that glyph.
        # Ungated, these generic patterns also match ordinary ANSWER prose: the tail of a
        # long ● answer wraps into the spinner zone just above the box, and a word like
        # "stream"/"downstream"/"offline" trips _BUSY_TEXT — pinning is_working True on a
        # finished, idle agent until the wall-clock timeout (the merge_targets hang).
        s = line.strip()
        if s and s[0] in _STATUS_GLYPHS and (_LIVE_ELAPSED.search(line)
                                             or _BUSY_TEXT.search(line)):
            return True
    return bool(SIG["working"].search(_input_region(frame, name)))


def _zone_has_glyph(zone: list[str]) -> bool:
    """True if any line in the spinner zone starts with an animation glyph — i.e. a
    spinner is present (of unknown text). Used to gate the motion backstop so a static
    markdown bullet in a settled answer can't be mistaken for an animating spinner."""
    for line in zone:
        s = line.strip()
        if s and s[0] in _STATUS_GLYPHS:
            return True
    return False


def input_box_present(frame: str, name: str) -> bool:
    return any(_rule_re(name).search(l) for l in frame.split("\n"))


def collapse_blanks(text: str) -> str:
    return re.sub(r"\n{3,}", "\n\n", text)


def clean_capture(text: str) -> list[str]:
    """Clean a capture-pane frame into readable transcript lines: strip ANSI/CR,
    drop box borders + gutters, trim blank padding, collapse blank runs."""
    lines = [strip_box_gutter(apply_cr(strip_ansi(l))).rstrip() for l in text.split("\n")]
    lines = [l for l in lines if not is_box_border_line(l)]
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    out: list[str] = []
    for l in lines:
        if not l.strip() and out and not out[-1].strip():
            continue
        out.append(l)
    return out


def cleaned_after_prompt(full: str, name: str) -> str:
    """Cleaned visible content after the echoed prompt — used as a fallback answer
    when there is no ● assistant block (e.g. an interactive question widget, or a
    timeout/crash before any reply)."""
    lines = clean_capture(full)
    idx = -1
    for i, l in enumerate(lines):
        if l.startswith("❯ ") and len(l.strip()) > 2:   # the echoed user prompt
            idx = i
    if idx >= 0:
        lines = lines[idx + 1:]
    lines = [l for l in lines if l.strip() != "❯"]       # drop the empty input line
    return collapse_blanks("\n".join(lines)).strip()


def split_frame(frame: str, name: str) -> tuple[list[str], bool]:
    """Split a captured frame into (response_lines, has_input_box).

    response_lines = cleaned transcript from the first assistant bullet that
    follows our prompt echo, up to the input-box rule. This skips the welcome
    banner and the echoed prompt; status/spinner lines are kept (callers filter).
    """
    lines = frame.split("\n")
    rule = _rule_re(name)
    boundary = len(lines)
    for i in range(len(lines) - 1, -1, -1):
        if rule.search(lines[i]):
            boundary = i
            break
    has_box = boundary < len(lines)
    resp: list[str] = []
    seen_echo = False
    started = False
    for raw in lines[:boundary]:
        line = strip_box_gutter(apply_cr(strip_ansi(raw))).rstrip()
        if is_box_border_line(line) or rule.search(line):
            continue
        if not started:
            if not seen_echo and SIG["prompt_echo"].search(line):
                seen_echo = True
                continue
            if seen_echo and SIG["assistant"].search(line):
                started = True
                resp.append(line)
            continue
        resp.append(line)
    return resp, has_box


def answer_from_response(resp: list[str], marker: str | None = None) -> str:
    """Extract the final assistant answer (last ● block) from response lines."""
    bullets = [i for i, l in enumerate(resp) if SIG["assistant"].search(l)]
    if bullets:
        start = bullets[-1]
        body = [re.sub(r"^●\s+", "", resp[start])]
        for l in resp[start + 1:]:
            if is_status_line(l) or SIG["assistant"].search(l) or SIG["prompt_echo"].search(l):
                break
            body.append(l)
    else:
        body = [l for l in resp if not is_status_line(l)]
    text = "\n".join(body)
    if marker:
        text = text.replace(marker, "")
    text = re.sub(r"\(\s*System note to the assistant.*?\)", "", text, flags=re.S)
    return collapse_blanks(text).strip()


class FrameDiffer:
    """Emit only newly-stable response lines across capture frames.

    A line is committed once it is identical in two consecutive frames, so a
    still-streaming last line is held back until it settles. Trailing blank lines
    are dropped to keep indices append-aligned. flush() emits whatever remains.
    Live streaming is cosmetic; the authoritative answer comes from the final
    capture via answer_from_response(), so an occasional glitch here is harmless.
    """

    def __init__(self, name: str, marker: str | None = None):
        self.name = name
        self.marker = marker
        self.emitted = 0
        self._prev: list[str] = []

    def _post(self, resp: list[str]) -> list[str]:
        """Filter split_frame() output down to streamable lines (drop spinners,
        the sentinel marker, trailing blanks). Takes the already-split response so
        the caller can share one split_frame() pass with the completion detector."""
        resp = [l for l in resp if not is_status_line(l)]
        if self.marker:
            resp = [l for l in resp if self.marker not in l]
        while resp and not resp[-1].strip():
            resp.pop()
        return resp

    def commit_new(self, resp: list[str]) -> list[str]:
        resp = self._post(resp)
        prev, self._prev = self._prev, resp
        stable = 0
        n = min(len(resp), len(prev))
        while stable < n and resp[stable] == prev[stable]:
            stable += 1
        new = resp[self.emitted:stable]
        self.emitted = max(self.emitted, stable)
        return new

    def flush(self, resp: list[str]) -> list[str]:
        resp = self._post(resp)
        new = resp[self.emitted:]
        self.emitted = max(self.emitted, len(resp))
        self._prev = resp
        return new


class CompletionDetector:
    """Hybrid completion FSM: sentinel (primary) + footer-idle (fallback)."""

    def __init__(self, name: str, marker: str | None, idle_secs: float,
                 clock=time.time):
        self.name = name
        self.marker = marker
        self.idle_secs = idle_secs
        self.clock = clock
        self.saw_working = False
        self._idle_since: float | None = None
        self._last_zone: str | None = None

    def verdict(self, frame: str, resp: list[str], has_box: bool,
                status: tuple[bool, int | None, str] | None = None
                ) -> tuple[str | None, object]:
        # `resp`/`has_box` are split_frame(frame) computed once by the caller and shared
        # with the FrameDiffer, so a poll does a single split pass, not two. `status` is the
        # pane (dead, code, cmd) fetched in the SAME tmux fork as `frame` (capture_with_status)
        # so a poll forks tmux once, not twice; fall back to a dedicated fork if not supplied.
        dead, code, _ = status if status is not None else pane_status(self.name)
        if dead:
            return "crash", code
        working = is_working(frame, self.name)
        # Motion backstop (display-agnostic): an animation glyph is present above the box
        # AND the spinner zone changed since the last poll ⇒ a turn is animating (spinner
        # cycling, timer ticking, retry counting down) even if its text matches none of the
        # patterns above. Gated on a glyph so a static markdown bullet in a settled answer
        # can't trip it, and scoped above the box so a custom statusLine clock can't either.
        zone = _spinner_zone(frame, self.name)
        zone_text = "\n".join(zone)
        if not working and _zone_has_glyph(zone) and self._last_zone is not None \
                and zone_text != self._last_zone:
            working = True
        self._last_zone = zone_text
        if working:
            self.saw_working = True
            self._idle_since = None
            return None, None

        # interactive multiple-choice question (AskUserQuestion) — it replaces the
        # input box, so handle it before the input-box-based idle logic below.
        if SIG["question_widget"].search(frame):
            if self._idle_since is None:
                self._idle_since = self.clock()
            elif self.clock() - self._idle_since >= min(self.idle_secs, 2.0):
                return "question", None
            return None, None

        resp_text = "\n".join(resp)
        answered = any(SIG["assistant"].search(l) for l in resp)

        # sentinel: the agent emitted the marker in its response region
        if self.marker and self.marker in resp_text:
            return "sentinel", None

        # footer-idle: a turn ran (or a response exists) and the box is idle
        if has_box and (self.saw_working or answered):
            now = self.clock()
            if self._idle_since is None:
                self._idle_since = now
            elif now - self._idle_since >= self.idle_secs:
                tail = [l for l in resp if l.strip() and not is_status_line(l)]
                if answered and tail and tail[-1].rstrip().endswith("?"):
                    return "question", None
                return "idle", None
        else:
            self._idle_since = None
        return None, None


