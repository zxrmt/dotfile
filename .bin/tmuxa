def parse_run_args(argv):
    p = argparse.ArgumentParser(
        prog="tmuxa",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Spawn and drive a Claude Code sub-agent inside a tmux session.\n\n"
            "Inspect sub-agents (running or finished):\n"
            "  tmuxa list                 list sessions (state, elapsed, cwd, prompt)\n"
            "  tmuxa logs <name>          dump a session's full pane (cleaned)\n"
            "    tmuxa logs <name> --full     ignore -n; show everything\n"
            "    tmuxa logs <name> -n N       only the last N lines\n"
            "    tmuxa logs <name> --grep RE  only lines matching RE\n"),
        epilog="verbs: tmuxa list | kill <name|--all> | attach <name> | logs <name>")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("-p", "--prompt", help="prompt to send to the agent ('-' reads stdin)")
    g.add_argument("--prompt-file", help="read the prompt from a file")
    p.add_argument("--name", help="session name (default: agent-<rand>); also the -n display name")
    p.add_argument("--cwd", help="working directory for the agent (default: $PWD)")
    p.add_argument("--model", help="pass through to claude --model")
    p.add_argument("--session-id", dest="session_id",
                   help="force `claude --session-id <uuid>` (default: a generated UUID) so the "
                        "native transcript path is deterministic; reported in --json as "
                        "claude_transcript / claude_transcript_exists")
    p.add_argument("--append-system-prompt", dest="append_system_prompt",
                   help="pass through to claude --append-system-prompt")
    p.add_argument("--system-prompt-file", dest="system_prompt_file",
                   help="read a system prompt from FILE and pass it via --append-system-prompt")
    p.add_argument("--tools",
                   help="pass through to claude --tools (allowed tools, e.g. 'Bash,Read')")
    p.add_argument("--disallowed-tools", dest="disallowed_tools",
                   help="pass through to claude --disallowedTools (e.g. 'Edit,Write,Task')")
    p.add_argument("--effort", help="pass through to claude --effort (e.g. high|max)")
    p.add_argument("--timeout", type=float, default=DEFAULTS["timeout"],
                   help="wall-clock budget for the working phase (s)")
    p.add_argument("--ready-timeout", type=float, default=DEFAULTS["ready_timeout"],
                   help="startup budget for the TUI (s)")
    p.add_argument("--idle-secs", type=float, default=DEFAULTS["idle_secs"],
                   help="quiescence window for idle-completion (s)")
    p.add_argument("--poll-ms", type=int, default=DEFAULTS["poll_ms"],
                   help="poll interval (ms)")
    p.add_argument("--agents-poll-ms", type=int, default=DEFAULTS["agents_poll_ms"],
                   help="throttle for the `claude agents --json` status poll (ms); this is the "
                        "primary completion signal (same method as tmux-claude-session-manager)")
    p.add_argument("--no-agents-status", dest="agents_status", action="store_false",
                   help="disable the claude-agents status signal; use only transcript/TUI detection")
    p.add_argument("--completion", choices=["hybrid", "idle", "sentinel"], default="hybrid",
                   help="done-detection strategy (default hybrid: sentinel + idle)")
    p.add_argument("--on-question", choices=["return", "wait"], default="return",
                   help="what to do if the agent stops to ask a question")
    p.add_argument("--keep", action="store_true", help="don't kill the session at the end")
    p.add_argument("--quiet", "-q", action="store_true", help="suppress live streaming")
    p.add_argument("--json", action="store_true", help="emit a JSON result envelope")
    p.add_argument("--full-transcript", action="store_true",
                   help="return the whole response, not just the final answer")
    p.add_argument("--verbose", "-v", action="store_true", help="log state to stderr")
    return p.parse_args(argv)


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    signal.signal(signal.SIGINT, _on_signal)
    signal.signal(signal.SIGTERM, _on_signal)
    verbs = {"list": cmd_list, "kill": cmd_kill, "attach": cmd_attach,
             "logs": cmd_logs, "batch": cmd_batch}
    if argv and argv[0] in verbs:
        return verbs[argv[0]](argv[1:])
    try:
        return cmd_run(parse_run_args(argv))
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())



